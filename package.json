{
  "name": "react-primitives",
  "version": "0.8.1",
  "description": "Primitive React Interfaces Across Targets",
  "main": "index.js",
  "scripts": {
    "prepublish": "npm run build",
    "build": "rm -rf lib && babel -d lib src",
    "build:webpack": "webpack",
    "build:watch": "npm run build -- --watch",
    "run:packager": "./node_modules/react-native/scripts/packager.sh",
    "run:ios": "react-native run-ios --project-path ./example/native/ios",
    "run:android": "react-native run-android --root ./example/android",
    "run:webpack": "webpack --watch",
    "test": "jest",
    "lint": "eslint .",
    "happo": "sh ./scripts/happo-ci.sh",
    "travis": "npm run --silent test && npm run --silent lint",
    "test:watch": "jest --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lelandrichardson/react-primitives.git"
  },
  "keywords": [
    "react"
  ],
  "author": "Leland Richardson <leland.richardson@airbnb.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lelandrichardson/react-primitives/issues"
  },
  "homepage": "https://github.com/lelandrichardson/react-primitives#readme",
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/core": "^7.23.0",
    "@babel/eslint-parser": "^7.23.0",
    "@babel/plugin-transform-object-rest-spread": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.23.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "browserify": "^17.0.0",
    "chai": "^4.3.10",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-babel-module": "^5.3.2",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.0",
    "happo": "^6.0.2",
    "jest": "^29.7.0",
    "karma": "^6.4.2",
    "karma-babel-preprocessor": "^8.0.2",
    "karma-browserify": "^8.1.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "mocha": "^10.2.0",
    "octonode": "^0.10.2",
    "react": "18.2.0",
    "react-art": "18.2.0",
    "react-dom": "18.2.0",
    "react-figma": "^0.31.0",
    "react-native": "^0.73.0",
    "react-native-web": "^0.19.0",
    "react-sketchapp": "^3.2.6",
    "react-test-renderer": "18.2.0",
    "watchify": "^4.0.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "animated": "^0.2.2",
    "create-react-class": "^15.7.0",
    "prop-types": "^15.8.1",
    "react-timer-mixin": "^0.13.4"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-art": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "react-native-web": ">=0.11.0"
  }
