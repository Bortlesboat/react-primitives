{
  "presets": [
    ["@babel/preset-env", {
      "targets": {
        "node": "current"
      }
    }],
    "@babel/preset-react"
  ],
  "plugins": [
    "@babel/plugin-transform-object-rest-spread",
    [
      "module-resolver",
      {
        "alias": {
          "react-primitives": "./"
        },
        "cwd": "babelrc"
      }
    ]
  ]
}
